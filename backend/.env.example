# Copy this file to .env and fill in real values before running the server.

# Port the Express server listens on
PORT=4000

# Secret key required in the x-admin-key header to add, edit, or delete films.
# Change this to something private before you deploy.
ADMIN_KEY=change-this-to-a-real-secret

# Allowed origin for the frontend during local development.
# If you serve the frontend from the backend itself (see server.js), this isn't needed.
FRONTEND_ORIGIN=http://localhost:5500
