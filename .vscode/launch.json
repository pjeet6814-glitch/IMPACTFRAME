{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start IMPACTFRAME Backend (Auto-Reload)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/server.js",
      "runtimeArgs": ["--watch"],
      "restart": true,
      "console": "integratedTerminal"
    }
  ]
}
